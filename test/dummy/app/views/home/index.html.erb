<% dummy_page_nav(title: "Navigation Demo", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Navigation Demo",
    subtitle: "Destinations registered with RecordingStudio::Navigation, queried the way a host app queries them.",
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(
        title: "How this page is built",
        subtitle: "Every row comes from the registry, not from this view.",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>
    <% end %>

    <% card.body do %>
      <ul class="space-y-3 text-sm leading-6">
        <li>
          <code>config/initializers/recording_studio_navigation.rb</code> registers the example destinations the way
          an addon gem would.
        </li>
        <li>
          The filters call <code>RecordingStudio::Navigation.destinations</code>,
          <code>destinations(tag: :admin)</code>, and <code>destinations(sensitivity: :sensitive)</code>.
        </li>
        <li>
          The route column calls <code>destination.route.resolve(self)</code> during the request, so a mounted engine
          path carries the host's mount prefix.
        </li>
        <li>
          Sensitivity is advisory. It marks destinations a host may want to treat carefully; it never decides who may
          see them.
        </li>
      </ul>
    <% end %>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <% @navigation_filters.each do |filter_key, filter_label| %>
      <%= render FlatPack::Button::Component.new(
        text: filter_label,
        style: filter_key == @navigation_filter ? :primary : :ghost,
        size: :sm,
        href: root_path(filter: filter_key)
      ) %>
    <% end %>
    <span class="text-sm text-(--surface-muted-content-color)">
      <%= pluralize(@destinations.size, "destination") %>
    </span>
  </div>

  <% if @destinations.any? %>
    <%= render FlatPack::Table::Component.new(data: @destinations, class: "text-sm") do |table| %>
      <% table.column(title: "Label") { |destination| destination.label } %>
      <% table.column(title: "Key") { |destination| destination.key } %>
      <% table.column(title: "Tags") { |destination| destination.tags.to_a.join(", ") } %>
      <% table.column(title: "Sensitivity") { |destination| destination.sensitivity.to_s } %>
      <% table.column(title: "Route") { |destination| navigation_route(destination) } %>
    <% end %>
  <% else %>
    <p class="text-sm text-(--surface-muted-content-color)">No destinations match this filter.</p>
  <% end %>
</div>
